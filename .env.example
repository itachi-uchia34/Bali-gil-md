# Required for Telegram commands and pairing-code delivery
TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_botfather

# Optional: restrict /status and owner-only actions
OWNER_TELEGRAM_ID=

# Optional public links shown by /deploy
PUBLIC_URL=https://your-deployed-domain.example
TELEGRAM_BOT_USERNAME=your_bot_username

# Hosting platforms usually provide PORT automatically
PORT=3000
